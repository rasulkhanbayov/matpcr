# Secrets -- never commit API keys / credentials
.env
*.env
**/secrets/**

# Large downloaded/external datasets (see CLAUDE.md section 9 for sources/provenance)
opxrd/
opxrd

# Python
__pycache__/
*.pyc

# LaTeX build artifacts (matpcr_snjnl.pdf is committed deliberately as the compiled proof;
# matpcr_snjnl.bbl is the precompiled bibliography and IS kept -- see CLAUDE.md's file
# table -- so .bbl is deliberately not listed here. The rest are regenerated by
# pdflatex/bibtex and not needed in git. Scoped to the top-level .tex build only, not
# *.log generally, since experiments/*.log are real experiment run logs, not LaTeX junk.
matpcr_snjnl.aux
matpcr_snjnl.log
matpcr_snjnl.out
matpcr_snjnl.blg
matpcr_snjnl.toc
matpcr_snjnl.fls
matpcr_snjnl.fdb_latexmk
matpcr_snjnl.synctex.gz

# Large HTML review pages -- regeneratable from the tracked *.jsonl result data via
# halfB_report.py / halfB_report_dft.py; excluded only because they're large (up to
# 14MB each) static renders, not because the data behind them isn't kept (it is --
# see the tracked experiments/*.jsonl files, the actual measured results).
experiments/halfB_review_*.html
experiments/__pycache__/

# Scratch/manual-review exports already summarized into CLAUDE.md
*.txt.bak

# arXiv preprint folder and the KBS revision source (contains the response to reviewers)
_Arxiv__Matpcr/
_Revision___Knowledge_Based_Systems__Matpcr/

# Internal review comments. These three were committed earlier; ignoring them does not
